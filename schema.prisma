generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  CHEMIST
  DEALER
  DISTRIBUTOR
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderType {
  CHEMIST_PURCHASE
  STOCK_PURCHASE
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  phone          String?
  passwordHash   String
  role           Role
  status         UserStatus @default(PENDING)
  businessName   String?
  drugLicenseNo  String?
  gstin          String?
  address        String?
  correctionNote String?
  correctionRequestedAt DateTime?
  assignedDealerId String?
  assignedDistributorId String?
  parentDistributorId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  assignedDealer User? @relation("ChemistDealer", fields: [assignedDealerId], references: [id], onDelete: SetNull)
  assignedChemists User[] @relation("ChemistDealer")
  assignedDistributor User? @relation("ChemistDistributor", fields: [assignedDistributorId], references: [id], onDelete: SetNull)
  distributorChemists User[] @relation("ChemistDistributor")
  parentDistributor User? @relation("DealerDistributor", fields: [parentDistributorId], references: [id], onDelete: SetNull)
  linkedDealers User[] @relation("DealerDistributor")
  notifications Notification[]
  documents      LicenseDocument[]
  ordersAsChemist Order[]   @relation("ChemistOrders")
  ordersAsDealer  Order[]   @relation("DealerOrders")
  auditEvents    AuditLog[] @relation("ActorAudit")
}

model LicenseDocument {
  id           String   @id @default(cuid())
  userId       String
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  reviewStatus String   @default("PENDING")
  reviewNote   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  composition  String?
  packSize     String?
  mrpPaise     Int
  dealerPaise  Int
  chemistPaise Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  batches      InventoryBatch[]
  orderItems   OrderItem[]
}

model InventoryBatch {
  id            String   @id @default(cuid())
  productId     String
  batchNo       String
  expiryDate    DateTime
  quantity      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, batchNo])
}

model Order {
  id              String       @id @default(cuid())
  orderNo         String       @unique
  orderType       OrderType    @default(CHEMIST_PURCHASE)
  chemistId       String?
  dealerId        String?
  status          OrderStatus  @default(PLACED)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotalPaise   Int
  taxPaise        Int          @default(0)
  totalPaise      Int
  deliveryAddress String
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  chemist         User?        @relation("ChemistOrders", fields: [chemistId], references: [id])
  dealer          User?        @relation("DealerOrders", fields: [dealerId], references: [id])
  items           OrderItem[]
  payment         Payment?
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPricePaise Int
  lineTotalPaise Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String        @default("RAZORPAY")
  providerPaymentId String?
  providerOrderId   String?
  amountPaise       Int
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("ActorAudit", fields: [actorId], references: [id], onDelete: SetNull)
}


model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}
