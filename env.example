# Copy these values into your cloud provider's Environment Variables.
# NEVER commit a real .env file or paste secrets into chat.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
PORT=3000
APP_BASE_URL="https://your-deployment.example"
# Optional integrations (not active until configured and tested)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v22.0"
# Use a private object-storage provider for production documents.
PRIVATE_STORAGE_MODE="local"
